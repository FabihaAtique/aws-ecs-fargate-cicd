resource "aws_db_subnet_group" "app" {
  count      = var.create_database ? 1 : 0
  name       = "${local.name}-db"
  subnet_ids = aws_subnet.private[*].id
}

# The master password is generated by RDS and stored in Secrets Manager
# (manage_master_user_password), so no secret ever appears in Terraform state or code.
resource "aws_db_instance" "app" {
  count                       = var.create_database ? 1 : 0
  identifier                  = "${local.name}-db"
  engine                      = "postgres"
  engine_version              = var.db_engine_version
  instance_class              = var.db_instance_class
  allocated_storage           = 20
  storage_type                = "gp3"
  storage_encrypted           = true
  db_name                     = "appdb"
  username                    = var.db_username
  manage_master_user_password = true
  db_subnet_group_name        = aws_db_subnet_group.app[0].name
  vpc_security_group_ids      = [aws_security_group.db[0].id]
  publicly_accessible         = false
  multi_az                    = false # POC; set true for production
  backup_retention_period     = 1
  auto_minor_version_upgrade  = true
  apply_immediately           = true
  skip_final_snapshot         = true # POC; keep a final snapshot in production
  deletion_protection         = false
}
